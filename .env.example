# ── AVENTA · environment template ───────────────────────────────────────
# Copy to .env and fill in. NEVER commit real secrets.

# App
APP_URL="http://localhost:3000"
NODE_ENV="development"

# Database
DATABASE_URL="postgresql://aventa:aventa_dev_pw@localhost:5544/aventa?schema=public"

# Auth — generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=""

# Document encryption — generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOC_ENCRYPTION_KEY=""
STORAGE_DIR="./.storage"

# Seed users (dev only)
SEED_ADMIN_EMAIL="admin@aventa.rent"
SEED_ADMIN_PASSWORD="change-me"
SEED_OWNER_EMAIL="owner@aventa.rent"
SEED_OWNER_PASSWORD="change-me"
SEED_DEMO_CLIENT_EMAIL="ivan@example.com"
SEED_DEMO_CLIENT_PASSWORD="change-me"

# Email (SMTP) — leave SMTP_HOST empty to log to console in dev
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="AVENTA <no-reply@aventa.rent>"
ADMIN_EMAIL="admin@aventa.rent"

# Telegram
TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

# WhatsApp (optional)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""

# Social / messenger sign-in (optional — buttons hide when unset)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
YANDEX_CLIENT_ID=""
YANDEX_CLIENT_SECRET=""
TELEGRAM_LOGIN_BOT_TOKEN=""
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""

# Stripe (test)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# PayPal (sandbox)
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_ENV="sandbox"

# Crypto wallets
CRYPTO_USDT_TRC20=""
CRYPTO_USDT_ERC20=""
CRYPTO_USDT_BEP20=""
CRYPTO_USDC_ERC20=""
CRYPTO_USDC_POLYGON=""

# Backups
BACKUP_DIR="./backups"
