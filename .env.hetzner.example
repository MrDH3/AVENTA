# ── AVENTA · Hetzner (docker-compose.prod.yml) environment ──────────────────
# Copy to `.env` on the server and fill in. NEVER commit the real .env.

# Your domain (Caddy issues HTTPS for it) + the public URL of the site.
DOMAIN=aventa.yourdomain.com
APP_URL=https://aventa.yourdomain.com
NODE_ENV=production
NODE_VERSION=20

# ── Database (the 'db' service). The password below MUST match POSTGRES_PASSWORD,
#    and the host is the compose service name `db`. ──────────────────────────
POSTGRES_USER=aventa
POSTGRES_PASSWORD=CHANGE_ME_to_a_long_random_password
POSTGRES_DB=aventa
DATABASE_URL=postgresql://aventa:CHANGE_ME_to_a_long_random_password@db:5432/aventa?schema=public

# ── Required secrets ────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Generate (MUST be 64 hex chars): node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DOC_ENCRYPTION_KEY=
# Documents are stored here (mounted to the `storage` docker volume — persists).
STORAGE_DIR=/app/.storage

# ── Optional integrations (features stay hidden until set) — see .env.example ──
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=AVENTA <no-reply@aventa.yourdomain.com>
# ADMIN_EMAIL=you@yourdomain.com
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_ADMIN_CHAT_ID=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# YANDEX_CLIENT_ID=
# YANDEX_CLIENT_SECRET=
# NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
# TELEGRAM_LOGIN_BOT_TOKEN=
# CRYPTO_USDT_TRC20=
# BACKUP_DIR=/app/backups
